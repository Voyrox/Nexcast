# Runtime parameters
BACKEND=docker
LISTEN_ADDR=:8081
SERVICES_FILE=services.yaml

# Kubernetes only
K8S_NAMESPACE=default

# Monitoring parameters
CHECK_INTERVAL=20s
COOLDOWN=60s

# Holt-Winters predictor (defaults shown)
HW_ALPHA=0.3
HW_BETA=0.1
HW_GAMMA=0.1
HW_DELTA=0.05
HW_HORIZON=6

# Optional
OBSERVATION_URL=
